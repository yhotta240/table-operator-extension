{
  "manifest_version": 3,
  "name": "Table Operator",
  "short_name": "Table Operator",
  "version": "0.0.1",
  "description": "Web ページ上の表を並び替え・フィルター・CSV出力できるようにします",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}