{
  "manifest_version": 3,
  "name": "Table Operator",
  "short_name": "Table Operator",
  "version": "0.1.0",
  "description": "",
  "icons": {
    "48": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
