{
  "manifest_version": 3,
  "name": "Table Operator - 列の並び替え・フィルター・CSV出力・列選択",
  "short_name": "Table Operator",
  "version": "0.2.1",
  "description": "Web ページ上の表を並び替え・フィルター・CSV出力できるようにします",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
